<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#ECEFF1"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- Suggestion Bar -->
    <LinearLayout
        android:id="@+id/suggestion_container"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/suggestion_1"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#263238"
            android:textSize="16sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#CFD8DC" />

        <Button
            android:id="@+id/suggestion_2"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#263238"
            android:textStyle="bold"
            android:textSize="16sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#CFD8DC" />

        <Button
            android:id="@+id/suggestion_3"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#263238"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Keyboard Visualization -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal">

            <Button android:text="Q" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="W" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="E" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="R" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="T" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="Y" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="U" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="I" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="O" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="P" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
        </LinearLayout>
        
        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <Button android:text="A" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="S" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="D" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="F" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="G" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="H" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="J" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="K" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="L" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal">

            <Button android:text="DEL" android:id="@+id/btn_delete" android:layout_weight="1.5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background_special" android:textColor="#263238" android:textSize="14sp" android:stateListAnimator="@null" />
            <Button android:text="Z" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="X" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="C" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="V" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="B" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="N" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="M" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
            <Button android:text="ENTER" android:id="@+id/btn_enter" android:layout_weight="1.5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background_special" android:textColor="#263238" android:textSize="14sp" android:stateListAnimator="@null" />
        </LinearLayout>
        
        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal">
            
            <Button android:text="@string/number_symbol_key" android:layout_weight="1.5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background_special" android:textColor="#263238" android:textSize="16sp" android:stateListAnimator="@null" />
            <Button android:text="SPACE" android:id="@+id/btn_space" android:layout_weight="6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background" android:textColor="#263238" android:textSize="16sp" android:stateListAnimator="@null" />
            <Button android:text="." android:id="@+id/btn_dot" android:layout_weight="1.5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/key_background_special" android:textColor="#263238" android:textSize="18sp" android:stateListAnimator="@null" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
